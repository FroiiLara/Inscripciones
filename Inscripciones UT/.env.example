# ======================================================
# Variables de entorno del Sistema de Inscripciones UTSC
# Copia este archivo como ".env" (que NO se sube a GitHub) y llena los valores.
# En Render se capturan en: Dashboard > tu servicio > Environment.
# ======================================================

# --- Claves de la aplicación (obligatorias; genera cada una con:
#     python -c "import secrets; print(secrets.token_hex(32))" ) ---
SECRET_KEY=
JWT_SECRET_KEY=

# --- Base de datos (MongoDB Atlas) ---
MONGO_URI=

# --- Cloudinary (documentos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SendGrid (correos) ---
SENDGRID_API_KEY=
FROM_EMAIL=

# --- hCaptcha ---
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# --- Geoapify (mapa de soporte) ---
GEOAPIFY_API_KEY=

# --- Opcionales ---
# En tu computadora (http://localhost) pon FLASK_ENV=development para que las cookies
# no exijan HTTPS. En Render NO lo definas.
# FLASK_ENV=development
# CORS_ORIGINS=https://otro-sitio.com
# CURP_VALIDACION_EXTERNA=true
# LIMITE_LOGIN=30 per minute; 400 per hour
# LIMITE_REGISTRO=30 per hour
# LIMITE_RECUPERAR=10 per hour
# LIMITE_TRAMITES=60 per hour
